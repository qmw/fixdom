---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- NAV -->
  <nav id="nav" class="fixed left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2 group" style="font-family: var(--font-display);">
        <span class="text-2xl font-800 tracking-tight text-white">Fix<span style="color: var(--color-orange);">Dom</span></span>
        <span class="hidden sm:inline-block text-xs font-500 text-white/50 border border-white/20 rounded px-1.5 py-0.5 ml-1">Warszawa</span>
      </a>

      <!-- Desktop Links -->
      <ul class="hidden lg:flex items-center gap-6 text-sm font-500 text-white/80">
        <li><a href="#uslugi" class="hover:text-orange-400 transition-colors">Usługi</a></li>
        <li><a href="#o-nas" class="hover:text-orange-400 transition-colors">O nas</a></li>
        <li><a href="#cennik" class="hover:text-orange-400 transition-colors">Cennik</a></li>
        <li><a href="#opinie" class="hover:text-orange-400 transition-colors">Opinie</a></li>
        <li><a href="#obszar" class="hover:text-orange-400 transition-colors">Obszar</a></li>
        <li><a href="#kontakt" class="hover:text-orange-400 transition-colors">Kontakt</a></li>
      </ul>

      <!-- CTA + Burger -->
      <div class="flex items-center gap-3">
        <a href="#kontakt" class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-700 text-white transition-all duration-200" style="background: var(--color-orange); font-family: var(--font-display);" onmouseover="this.style.background='var(--color-orange-dark)'" onmouseout="this.style.background='var(--color-orange)'">
          Zamów fachowca
        </a>
        <button id="burger" class="lg:hidden flex flex-col gap-1.5 p-2 group" aria-label="Menu">
          <span class="block w-6 h-0.5 bg-white transition-all"></span>
          <span class="block w-6 h-0.5 bg-white transition-all"></span>
          <span class="block w-4 h-0.5 bg-white transition-all"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden lg:hidden px-4 pb-4" style="background: rgba(20,33,61,0.97); border-top: 1px solid rgba(249,115,22,0.2);">
      <ul class="flex flex-col gap-1 pt-2 text-sm font-500">
        <li><a href="#uslugi" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">Usługi</a></li>
        <li><a href="#o-nas" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">O nas</a></li>
        <li><a href="#cennik" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">Cennik</a></li>
        <li><a href="#opinie" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">Opinie</a></li>
        <li><a href="#obszar" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">Obszar</a></li>
        <li><a href="#kontakt" class="block py-2.5 text-white/80 hover:text-orange-400 transition-colors">Kontakt</a></li>
        <li class="pt-2">
          <a href="#kontakt" class="block text-center py-2.5 rounded-lg text-white font-700" style="background: var(--color-orange); font-family: var(--font-display);">Zamów fachowca</a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- HERO -->
  <header class="relative min-h-screen flex items-center overflow-hidden" style="background: var(--color-navy);">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
      <img
        src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=1600&q=80&auto=format&fit=crop"
        alt="Fachowiec przy pracy"
        class="w-full h-full object-cover object-center"
        style="opacity: 0.35;"
      />
      <!-- Gradient overlay -->
      <div class="absolute inset-0" style="background: linear-gradient(110deg, rgba(20,33,61,0.92) 0%, rgba(20,33,61,0.75) 50%, rgba(20,33,61,0.55) 100%);"></div>
    </div>

    <!-- Decorative diagonal stripe -->
    <div class="absolute bottom-0 right-0 w-1/3 h-full z-0 hidden lg:block" style="background: linear-gradient(135deg, transparent 40%, rgba(249,115,22,0.08) 100%);"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 pt-32 pb-20">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 mb-6 reveal">
        <span class="flex h-2.5 w-2.5 rounded-full" style="background: var(--color-orange);">
          <span class="animate-ping absolute inline-flex h-2.5 w-2.5 rounded-full opacity-75" style="background: var(--color-orange);"></span>
        </span>
        <span class="text-xs font-700 tracking-widest uppercase text-white/70" style="font-family: var(--font-display);">Dojazd 24h · Warszawa i okolice</span>
      </div>

      <!-- Headline -->
      <h1 class="reveal text-5xl sm:text-6xl lg:text-7xl font-800 text-white leading-tight max-w-3xl mb-6" style="font-family: var(--font-display); transition-delay: 0.1s;">
        Awaria?<br/>
        <span style="color: var(--color-orange);">Jesteśmy u Ciebie</span><br/>
        w 45 minut.
      </h1>

      <!-- Subheadline -->
      <p class="reveal text-lg sm:text-xl text-white/70 max-w-xl mb-10 leading-relaxed" style="transition-delay: 0.2s;">
        Hydraulika, elektryka, drobne naprawy — szybko, solidnie i bez niespodzianek w cenie. Ponad 3 000 zrealizowanych zleceń w Warszawie.
      </p>

      <!-- CTAs -->
      <div class="reveal flex flex-col sm:flex-row gap-4 items-start" style="transition-delay: 0.3s;">
        <a href="#kontakt" class="inline-flex items-center gap-2 px-7 py-4 rounded-xl text-base font-700 text-white shadow-lg transition-all duration-200 hover:scale-105" style="background: var(--color-orange); font-family: var(--font-display); box-shadow: 0 4px 24px rgba(249,115,22,0.4);" onmouseover="this.style.background='var(--color-orange-dark)'" onmouseout="this.style.background='var(--color-orange)'">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Zamów fachowca
        </a>
        <a href="tel:223456789" class="inline-flex items-center gap-3 px-6 py-4 rounded-xl text-base font-700 text-white border-2 border-white/30 hover:border-white/60 transition-all duration-200 hover:bg-white/10" style="font-family: var(--font-display);">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          tel. 22 345 67 89
        </a>
      </div>

      <!-- Stats bar -->
      <div class="reveal mt-16 flex flex-wrap gap-6 sm:gap-10" style="transition-delay: 0.4s;">
        <div class="flex flex-col">
          <span class="text-3xl font-800 text-white" style="font-family: var(--font-display);">3000+</span>
          <span class="text-xs text-white/50 uppercase tracking-wider mt-0.5">Zleceń rocznie</span>
        </div>
        <div class="w-px bg-white/20 hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-3xl font-800 text-white" style="font-family: var(--font-display);">45 min</span>
          <span class="text-xs text-white/50 uppercase tracking-wider mt-0.5">Czas dojazdu</span>
        </div>
        <div class="w-px bg-white/20 hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-3xl font-800 text-white" style="font-family: var(--font-display);">12 mies.</span>
          <span class="text-xs text-white/50 uppercase tracking-wider mt-0.5">Gwarancja</span>
        </div>
        <div class="w-px bg-white/20 hidden sm:block"></div>
        <div class="flex flex-col">
          <span class="text-3xl font-800 text-white" style="font-family: var(--font-display);">24/7</span>
          <span class="text-xs text-white/50 uppercase tracking-wider mt-0.5">Awarie</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 animate-bounce">
      <span class="text-white/30 text-xs tracking-widest uppercase">Więcej</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </header>

  <!-- USŁUGI -->
  <section id="uslugi" class="py-24" style="background: var(--color-white-soft);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <p class="reveal text-xs font-700 tracking-widest uppercase mb-3" style="color: var(--color-orange); font-family: var(--font-display);">Co robimy</p>
        <h2 class="reveal text-4xl sm:text-5xl font-800 text-navy" style="color: var(--color-navy); font-family: var(--font-display); transition-delay: 0.1s;">Nasze usługi</h2>
        <p class="reveal text-lg text-gray-500 mt-4 max-w-xl mx-auto" style="transition-delay: 0.2s;">Kompleksowa obsługa techniczna Twojego mieszkania lub domu — jeden numer, jeden fachowiec.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Card 1: Hydraulika -->
        <div class="reveal group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border-t-4 cursor-default" style="border-top-color: var(--color-orange); transition-delay: 0.05s;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background: rgba(249,115,22,0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: var(--color-orange);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1M4.22 4.22l.707.707m12.727 12.727.707.707M3 12h1m16 0h1M4.22 19.78l.707-.707m12.727-12.727.707-.707M12 7a5 5 0 100 10A5 5 0 0012 7z" />
            </svg>
          </div>
          <h3 class="text-xl font-700 mb-2" style="color: var(--color-navy); font-family: var(--font-display);">Hydraulika</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Naprawy kranów, rur, odpływów, uszczelki, instalacje wodne i kanalizacyjne. Usuwamy przecieki i awarie.</p>
          <ul class="mt-4 space-y-1.5 text-sm text-gray-400">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Naprawa kranów i baterii
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Udrażnianie odpływów
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Wymiana rur i złączek
            </li>
          </ul>
        </div>

        <!-- Card 2: Elektryka -->
        <div class="reveal group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border-t-4 cursor-default" style="border-top-color: var(--color-orange); transition-delay: 0.1s;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background: rgba(249,115,22,0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: var(--color-orange);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-700 mb-2" style="color: var(--color-navy); font-family: var(--font-display);">Elektryka</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Montaż gniazdek i włączników, wymiana bezpieczników, instalacja oświetlenia LED, diagnostyka instalacji.</p>
          <ul class="mt-4 space-y-1.5 text-sm text-gray-400">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Gniazdka i włączniki
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Oświetlenie LED
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Bezpieczniki i skrzynki
            </li>
          </ul>
        </div>

        <!-- Card 3: Naprawy -->
        <div class="reveal group bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border-t-4 cursor-default" style="border-top-color: var(--color-orange); transition-delay: 0.15s;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background: rgba(249,115,22,0.1);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: var(--color-orange);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" />
            </svg>
          </div>
          <h3 class="text-xl font-700 mb-2" style="color: var(--color-navy); font-family: var(--font-display);">Drobne naprawy</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Wiercenie, kołkowanie, montaż drzwi i mebli, układanie paneli podłogowych i inne prace wykończeniowe.</p>
          <ul class="mt-4 space-y-1.5 text-sm text-gray-400">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Wiercenie i kołkowanie
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Montaż mebli i drzwi
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Układanie paneli
            </li>
          </ul>
        </div>

        <!-- Card 4: Awarie 24/7 -->
        <div class="reveal group rounded-2xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 border-t-4 cursor-default" style="border-top-color: var(--color-orange); background: var(--color-navy); transition-delay: 0.2s;">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5" style="background: rgba(249,115,22,0.2);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: var(--color-orange);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-700 mb-2 text-white" style="font-family: var(--font-display);">Awarie 24/7</h3>
          <p class="text-white/60 text-sm leading-relaxed">Błyskawiczny dojazd do awarii — zalania, przerwy w prądzie, pęknięte rury. Jesteśmy dostępni całą dobę.</p>
          <ul class="mt-4 space-y-1.5 text-sm text-white/40">
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Zalania i przecieki
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Przerwy w prądzie
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 20 20" style="color: var(--color-orange);"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Dojazd do 45 min
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- DLACZEGO MY -->
  <section id="o-nas" class="py-24" style="background: var(--color-navy);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-16">
        <p class="reveal text-xs font-700 tracking-widest uppercase mb-3" style="color: var(--color-orange); font-family: var(--font-display);">Nasze wartości</p>
        <h2 class="reveal text-4xl sm:text-5xl font-800 text-white" style="font-family: var(--font-display); transition-delay: 0.1s;">Dlaczego FixDom?</h2>
        <p class="reveal text-lg text-white/50 mt-4 max-w-xl mx-auto" style="transition-delay: 0.2s;">Nie obiecujemy cudów — dostarczamy solidną pracę w terminie i w cenie.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Szybko -->
        <div class="reveal text-center p-8 rounded-2xl" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); transition-delay: 0.05s;">
          <div class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-5" style="background: rgba(249,115,22,0.15); border: 2px solid rgba(249,115,22,0.3);">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" style="color: var(--color-orange);">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="text-4xl font-800 text-white mb-1" style="font-family: var(--font-display);">45 min</div>
          <div class="text-base font-700 text-white mb-2" style="font-family: var(--font-display);">Szybko</div>
